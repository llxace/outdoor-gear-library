<Window x:Class="OutdoorGear.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="户外装备库" Width="1680" Height="1080" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="24,25,16,24"><TextBlock Text="⛰  户外装备库" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Windows 原生版 · 0.20.4" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="2,7,0,0"/></StackPanel>
   <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,12" Margin="14,0,14,14"><DockPanel><Ellipse x:Name="ProfileAvatar" Width="38" Height="38" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0" DockPanel.Dock="Left"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CurrentUserName" Text="默认用户" FontWeight="SemiBold"/><TextBlock Text="本机用户资料库" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="⋯" DockPanel.Dock="Right" Padding="8,4" Click="ProfileMenu_Click"/></DockPanel></Border>
   <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" Margin="12,0,12,12"><ListBoxItem Tag="打包"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="打包"/></StackPanel></ListBoxItem><ListBoxItem Tag="仪表盘"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="仪表盘"/></StackPanel></ListBoxItem><ListBoxItem Tag="个人专栏"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="个人专栏"/></StackPanel></ListBoxItem><ListBoxItem Tag="装备库"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="装备库"/></StackPanel></ListBoxItem><ListBoxItem Tag="设置"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="设置"/></StackPanel></ListBoxItem><ListBoxItem Tag="回收站"><StackPanel Orientation="Horizontal"><TextBlock Text="♲" Width="31" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="回收站"/></StackPanel></ListBoxItem></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,18,30,22"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0"><TextBlock x:Name="PageTitle" Text="打包" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="＋ 添加别人的装备" Click="Borrow_Click" Margin="0,0,14,0"/><TextBlock Text="用户装备库" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="ProfileSelector" Width="155" SelectionChanged="ProfileSelector_SelectionChanged" DisplayMemberPath="Name"/></StackPanel></DockPanel>
   <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,6,0,0"/>
   <TextBlock x:Name="StatusText" Grid.Row="2" Text="数据保存在本机" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>
