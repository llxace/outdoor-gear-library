<UserControl x:Class="OutdoorGear.Wpf.Features.Packing.Presentation.PackingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <Grid><Grid.RowDefinitions><RowDefinition Height="310"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.ColumnSpan="2" Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="⌖  本次路线" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="RouteNameText" Text="未选择路线" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="RouteDistanceText" Text="选择路线后显示距离" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="⌕  更换路线" DockPanel.Dock="Right" Click="SearchRoute_Click" Margin="12,0,0,0"/><Button Content="清除路线" DockPanel.Dock="Right" Click="RemoveRoute_Click" Margin="8,0,0,0"/></DockPanel>
    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><TextBlock Text="☼  天气预报 · 出发时段" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><DatePicker x:Name="DepartureDate" SelectedDateChanged="DepartureChanged" Width="132" Margin="16,0,6,0"/><ComboBox x:Name="DepartureTime" Width="93" SelectionChanged="DepartureTime_SelectionChanged"/><Button x:Name="DetailedWeatherButton" Content="详细天气" Click="ToggleDetailedWeather_Click" Padding="7,3" Margin="8,0,0,0" Visibility="Collapsed"/><Button Content="↻" ToolTip="刷新预报" Click="RefreshWeather_Click" Padding="7,3" Margin="8,0,0,0"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CurrentCondition" Text="—" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="CurrentTemperature" Text="—°" FontSize="46" FontWeight="Light" Margin="0,4"/><TextBlock x:Name="FeelsLike" Text="体感 —°" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="DepartureWeatherTime" Foreground="{DynamicResource MutedBrush}" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="DepartureDayRange" Foreground="{DynamicResource MutedBrush}" FontSize="11" Visibility="Collapsed"/><TextBlock x:Name="ElevationText" Text="路线网格海拔 —" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="ForecastList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ForecastCardBrush}" CornerRadius="10" Padding="11,9" Width="100" Margin="0,6,8,6"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Condition}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8"/><TextBlock Text="{Binding TemperatureLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding RainLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="{Binding WindLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="WeatherTrendSummary" Grid.Column="1" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" Visibility="Collapsed"/></Grid><TextBlock x:Name="WeatherStatus" Grid.Row="2" Text="选择路线后加载行前天气" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/></Grid>
    <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions><DockPanel Grid.Row="0"><TextBlock Text="◈  路线图" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="MapModeButton" Content="卫星地图" Click="MapType_Click" Padding="9,3" Margin="0,0,6,0"/><Button Content="放大" Click="ExpandMap_Click" Padding="9,3"/></StackPanel></DockPanel><Border Grid.Row="1" Background="#142C2A" CornerRadius="10" Margin="0,5,0,5" ClipToBounds="True"><Grid><Canvas x:Name="RouteCanvas" Background="#183A37" SizeChanged="RouteCanvas_SizeChanged" MouseLeftButtonDown="RouteCanvas_MouseLeftButtonDown" MouseMove="RouteCanvas_MouseMove" MouseLeftButtonUp="RouteCanvas_MouseLeftButtonUp"><Polyline x:Name="RouteLine" Stroke="#0E9BFF" StrokeThickness="3" StrokeLineJoin="Round" Points=""/></Canvas><TextBlock x:Name="MapCaption" Text="选择路线以显示轨迹" Foreground="#D1E9E1" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><Button Content="＋" Click="ZoomIn_Click" Width="38" Padding="5"/><Button Content="－" Click="ZoomOut_Click" Width="38" Margin="6,0,0,0" Padding="5"/></StackPanel></Grid></Border><DockPanel Grid.Row="2" LastChildFill="False" VerticalAlignment="Center"><TextBlock x:Name="RouteStats" Text="路线距离与海拔将在选择路线后显示" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button x:Name="OutlookButton" Content="远期趋势" Click="Outlook_Click" DockPanel.Dock="Right" Padding="10,4"/></DockPanel></Grid>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="0,10,0,10" Padding="16,8"><DockPanel><TextBlock Text="▤  装备清单" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock x:Name="TotalWeight" Text="0.000 kg" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock x:Name="WeightGrams" Text="0 g" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock x:Name="PackValue" Text="装备价值 ¥0.00" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock x:Name="SelectedCount" Text="已选 0 项装备" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="撤销清空" Click="UndoClear_Click" Margin="0,0,8,0"/><Button Content="♲  一键清空" Click="ClearPacking_Click"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="打包内容" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><RadioButton x:Name="EquipmentTab" Content="装备清单" GroupName="PackTab" IsChecked="True" Checked="Tab_Checked"/><RadioButton x:Name="MealTab" Content="路餐与饮水" GroupName="PackTab" Checked="Tab_Checked"/></StackPanel><TextBlock x:Name="PackSubSummary" Text="装备与路餐重量统计" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
   <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True"><Grid x:Name="ModeContent"><Grid x:Name="EquipmentContent"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel><TextBlock Text="装备分类" FontWeight="SemiBold" Margin="16,14" DockPanel.Dock="Top"/><ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedValuePath="Path" SelectionChanged="Category_Selected"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="▦" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><DockPanel Grid.Column="1" Margin="14"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="全部装备" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox x:Name="GearSearch" Width="380" Height="37" VerticalContentAlignment="Center" Margin="18,0,12,0" TextChanged="GearSearch_TextChanged"/><CheckBox x:Name="SelectedOnly" Content="只看已选" VerticalAlignment="Center" Checked="SelectedOnly_Changed" Unchecked="SelectedOnly_Changed"/></DockPanel><DataGrid x:Name="PackingGrid" ItemsSource="{Binding Rows}" IsReadOnly="False" AutoGenerateColumns="False" CanUserSortColumns="True"><DataGrid.Columns><DataGridTemplateColumn Header="携带" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsPacking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="照片" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="46" Height="46" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource SurfaceAltBrush}"><Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="装备名称" Width="2.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WeightLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="1.1*" IsReadOnly="True"/><DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="1*" IsReadOnly="True"/><DataGridTemplateColumn Header="携带数量" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" Padding="8,4" Tag="{Binding}" Click="DecreaseQuantity_Click"/><TextBox Text="{Binding PackQuantity, UpdateSourceTrigger=LostFocus}" Width="48" TextAlignment="Center" Margin="5,0" VerticalContentAlignment="Center"/><Button Content="＋" Padding="8,4" Tag="{Binding}" Click="IncreaseQuantity_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="小计" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PackWeightLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></Grid><ContentControl x:Name="MealContent" Visibility="Collapsed"/></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
